# Copy this file to .env and fill in your keys. Never commit the real .env.

# Which LLM to use: groq (free, default) or anthropic
LLM_PROVIDER=groq

# Model id for the chosen provider (no provider prefix needed; the code adds it).
# groq example:      openai/gpt-oss-120b  (reliable tool calls; llama-3.3-70b can garble them)
# anthropic example: claude-sonnet-4-6
LLM_MODEL=openai/gpt-oss-120b

# LLM API keys (set the one that matches LLM_PROVIDER)
GROQ_API_KEY=your_groq_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here

# Materials Project (free key from https://materialsproject.org/api)
MP_API_KEY=your_materials_project_key_here

# RapidAPI (optional): subscribe to a periodic-table API on rapidapi.com and put
# your key here to use the RapidAPI path. If left unset, the element tool falls
# back to a free periodic-table API and still works. Set RAPIDAPI_HOST if you use
# a different RapidAPI provider.
RAPIDAPI_KEY=your_rapidapi_key_here
# RAPIDAPI_HOST=periodic-table-of-elements1.p.rapidapi.com
